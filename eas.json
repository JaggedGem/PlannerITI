{
  "cli": {
    "version": "25.3.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "development",
        "ANDROID_PACKAGE": "site.jagged.planneriti.dev",
        "IOS_BUNDLE_IDENTIFIER": "site.jagged.planneriti.dev",
        "RUNTIME_VERSION": "1.6.0-dev.2"
      },
      "environment": "development",
      "node": "24.19.0",
      "pnpm": "11.1.2"
    },
    "beta": {
      "autoIncrement": true,
      "distribution": "internal",
      "channel": "beta",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "APP_VARIANT": "beta",
        "ANDROID_PACKAGE": "site.jagged.planneriti.beta",
        "IOS_BUNDLE_IDENTIFIER": "site.jagged.planneriti.beta",
        "RUNTIME_VERSION": "1.6.0-beta.2"
      },
      "environment": "preview",
      "node": "24.19.0",
      "pnpm": "11.1.2"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "APP_VARIANT": "production",
        "ANDROID_PACKAGE": "site.jagged.planneriti",
        "IOS_BUNDLE_IDENTIFIER": "site.jagged.planneriti",
        "RUNTIME_VERSION": "1.6.0-native-updates.1"
      },
      "environment": "production",
      "node": "24.19.0",
      "pnpm": "11.1.2"
    }
  },
  "submit": {
    "production": {}
  }
}
