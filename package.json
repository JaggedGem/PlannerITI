{
  "name": "planneriti",
  "main": "expo-router/entry",
  "version": "1.6.0",
  "scripts": {
    "dev": "expo start --dev-client",
    "dev:clear": "expo start --clear --dev-client",
    "dev:go": "expo start --go",
    "test": "jest --watchAll=false",
    "test:watch": "jest --watchAll",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "build": "eas build --profile production --platform android",
    "build:ios": "eas build --profile production --platform ios",
    "build:dev": "eas build --profile development --platform android",
    "build:dev:ios": "eas build --profile development --platform ios",
    "build:dev:local": "eas build --profile development --platform android --local",
    "build:dev:local:ios": "eas build --profile development --platform ios --local",
    "update": "eas update --channel production --platform android",
    "update:ios": "eas update --channel production --platform ios",
    "build:apks": "node scripts/build-apks.js",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    }
  },
  "dependencies": {
    "@expo/dom-webview": "~58.0.2",
    "@expo/metro-runtime": "~58.0.14",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-vector-icons/feather": "^13.1.4",
    "@react-native-vector-icons/fontawesome": "^13.1.4",
    "@react-native-vector-icons/ionicons": "^13.1.4",
    "@react-native-vector-icons/material-icons": "^13.1.4",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.7",
    "expo": "58.0.16",
    "expo-application": "~58.1.2",
    "expo-blur": "~58.0.5",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.14",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.9",
    "expo-haptics": "~58.0.7",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.13",
    "expo-navigation-bar": "~58.0.4",
    "expo-notifications": "~58.1.5",
    "expo-print": "~58.0.7",
    "expo-router": "~58.0.24",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.19",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-updates": "~58.0.17",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-worklets": "0.13.0",
    "react-native-worklets-core": "^1.6.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "^19.3.0",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.11",
    "prettier": "^3.9.10",
    "react-dom": "19.3.0",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3"
  },
  "packageManager": "pnpm@11.1.2",
  "private": true
}
