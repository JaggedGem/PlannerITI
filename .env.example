# Optional custom API overrides for local development
CUSTOM_API_LOCAL_URL=
CUSTOM_API_LOCAL_HOST=
CUSTOM_API_LOCAL_PORT=5000

# Enable only when site.jagged.planneriti.beta has its own Play listing/testing setup.
