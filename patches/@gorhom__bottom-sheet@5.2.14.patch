diff --git a/src/utilities/getAnimationDependencies.ts b/src/utilities/getAnimationDependencies.ts
new file mode 100644
index 0000000000000000000000000000000000000000..ee9076c5cbe2daf8def7a404d911a5ed1c6ac7d7
--- /dev/null
+++ b/src/utilities/getAnimationDependencies.ts
@@ -0,0 +1,5 @@
+import { Platform } from 'react-native';
+
+// Reanimated 4.7 ignores explicit dependencies on native; web still needs them without the Babel plugin.
+export const getAnimationDependencies = <T>(dependencies: T): T | undefined =>
+  Platform.OS === 'web' ? dependencies : undefined;
